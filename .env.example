# Supabase — obtén estos valores en tu proyecto: Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key"

# Solo para scripts/servidor (NUNCA exponer al cliente). Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# Datos del restaurante para el pedido por WhatsApp (formato internacional sin +, ej. 5219999999999)
NEXT_PUBLIC_WHATSAPP_PHONE="5219999999999"
NEXT_PUBLIC_RESTAURANT_NAME="Burger Point"

# URL pública del sitio: la usa el QR de los tickets. Sin ella apunta a localhost.
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"

# ---------------------------------------------------------------
# WhatsApp Cloud API (API oficial de Meta). Todo esto es de servidor.
# Se saca de developers.facebook.com > tu app > WhatsApp > Configuración.
# ---------------------------------------------------------------
# Token permanente del usuario de sistema (NO el temporal de 24 h).
WHATSAPP_ACCESS_TOKEN=""
# "Phone number ID" del número emisor: es un id numérico, no el teléfono.
WHATSAPP_PHONE_NUMBER_ID=""
# Número que recibe la alerta de pedido nuevo (E.164 sin '+').
WHATSAPP_ALERT_TO="5219999999999"
# Opcionales (traen valor por defecto):
# WHATSAPP_GRAPH_VERSION="v21.0"
# WHATSAPP_TEMPLATE_LANG="es_MX"
# WHATSAPP_COUNTRY_CODE="52"
# WA_TPL_ALERTA="pedido_nuevo_alerta"
# WA_TPL_ESTADO="pedido_estado"

# Webhook (para recibir mensajes): lo inventas tú y lo repites en Meta.
WHATSAPP_VERIFY_TOKEN=""
# App Secret de la app de Meta: valida la firma de los webhooks.
# Sin él el webhook responde 503: no se aceptan mensajes sin poder verificarlos.
WHATSAPP_APP_SECRET=""

# --- Bot de pedidos ---
# Costo de envío que aplica el bot a los pedidos a domicilio. 0 = sin cargo.
# WHATSAPP_DELIVERY_FEE="30"
# Permite gastar plantillas DE PAGO para avisar el estado a quien pidió por la
# web (nunca nos escribió, así que no hay ventana gratis). Apagado por defecto.
# WHATSAPP_STATUS_TEMPLATES="1"
# Simulador del bot en /api/whatsapp/simular: probar la conversación sin Meta.
# Solo para desarrollo; si no vale "1", esa ruta responde 404.
# WHATSAPP_SIMULATOR="1"

# --- IA del bot (DeepSeek) ---
# Con esta llave el bot conversa en lenguaje natural; sin ella cae al menú
# numerado, que sigue funcionando igual. api-docs.deepseek.com
DEEPSEEK_API_KEY=""
# deepseek-v4-flash (barato y rápido, el de siempre) o deepseek-v4-pro.
# DEEPSEEK_MODEL="deepseek-v4-flash"
# Apaga la IA sin borrar la llave (útil para comparar o si se pasa de costo).
# WHATSAPP_AI="0"
